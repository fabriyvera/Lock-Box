# Copia a back-end/.env y completa los valores de tu proyecto.
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
SUPABASE_URL=
# Se prefiere publishable. ANON_KEY es la alternativa legacy.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
# No se necesita service_role: las consultas usan el JWT del vendedor y RLS.
TURNSTILE_SECRET_KEY=
