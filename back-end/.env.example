# Copia a back-end/.env y completa los valores de tu proyecto.
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Orígenes adicionales exactos, separados por comas; sin rutas ni comodines.
# FRONTEND_URL sigue siendo la URL principal para las confirmaciones por correo.
CORS_ALLOWED_ORIGINS=
SUPABASE_URL=
# Se prefiere publishable. ANON_KEY es la alternativa legacy.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
# No se necesita service_role: las consultas usan el JWT del vendedor y RLS.
TURNSTILE_SECRET_KEY=
