# Copia a front-end/.env.local y completa las claves del mismo proyecto.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública publishable; ANON_KEY es la alternativa legacy.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Google Maps: browser key restricted to this website and Maps JavaScript + Geocoding APIs.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# JavaScript map ID from the same Google Cloud project (not a project ID).
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
